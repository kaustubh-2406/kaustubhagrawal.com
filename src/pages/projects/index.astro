---
import { Image } from 'astro:assets';
import Card from '../../components/Card.astro';
import Pill from '../../components/Pill.astro';
import { getProjects } from '../../data/projects';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Things Kaustubh has built.">
	<h1 class="text-h1 font-bold text-heading">Projects</h1>
	<p class="mt-3 text-muted">Things I've built, and things I'm still building.</p>

	<div class="mt-8 grid gap-6 sm:grid-cols-2">
		{projects.map((project) => (
			<a href={`/projects/${project.id}`} class="block">
				<Card class="flex h-full flex-col">
					{project.data.cover ? (
						<Image
							src={project.data.cover}
							alt=""
							class="aspect-video w-full object-cover"
							widths={[400, 800]}
							sizes="(min-width: 640px) 50vw, 100vw"
						/>
					) : (
						<div class="flex aspect-video items-center justify-center bg-surface font-mono text-xs text-faint">
							no cover yet
						</div>
					)}
					<div class="flex flex-1 flex-col gap-2 p-4">
						<p class="flex items-center gap-2">
							<span class="font-bold text-heading" transition:name={`project-title-${project.id}`}>
								{project.data.name}
							</span>
							<Pill accent class="ml-auto">
								{project.data.status}
							</Pill>
						</p>
						<p class="text-sm text-muted">{project.data.oneLiner}</p>
						<p class="mt-auto flex flex-wrap gap-2 pt-2">
							{project.data.stack.map((t) => (
								<Pill>{t}</Pill>
							))}
						</p>
					</div>
				</Card>
			</a>
		))}

		<div class="flex flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-border p-6 text-center">
			<span class="font-mono text-sm text-faint">+ more coming</span>
			<span class="text-xs text-faint">A couple more things are in progress.</span>
		</div>
	</div>

	<!-- Remembered from a stream, no source found yet, so credited "roughly". -->
	<aside
		aria-label="A note"
		class="relative mt-10 ml-2 w-56 -rotate-2 rounded-sm border border-warm/20 bg-warm/10 px-3 py-2"
	>
		<span aria-hidden="true" class="absolute -top-1.5 left-1/2 h-3 w-10 -translate-x-1/2 rotate-3 bg-faint/30"></span>
		<p class="doodle-note text-warm">none of my projects are abandoned, they're just paused</p>
		<p class="mt-1 font-mono text-xs text-muted">— Tsoding, roughly</p>
	</aside>
</BaseLayout>
