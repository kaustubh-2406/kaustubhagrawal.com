---
// A labelled aside, not a heading: it summarises the page rather than starting a section.
import Card from './Card.astro';

interface Props {
	label: string;
	class?: string;
}

const { label, class: className } = Astro.props;
---

<aside aria-label={label} class={className}>
	<Card class="p-4">
		<p class="font-hand text-h3 leading-none font-medium text-heading">{label}</p>
		<dl class="mt-3 grid grid-cols-[auto_1fr] items-baseline gap-x-4 gap-y-1.5 text-sm">
			<slot />
		</dl>
		<slot name="actions" />
	</Card>
</aside>
