---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
	accent?: boolean; // a state (like project status), not a label
}

const { accent = false, class: className = '', ...rest } = Astro.props;
---

<span
	class:list={[
		'rounded-full border border-border px-2.5 py-0.5 font-mono text-xs',
		accent ? 'whitespace-nowrap text-accent' : 'text-muted',
		className,
	]}
	{...rest}
>
	<slot />
</span>
